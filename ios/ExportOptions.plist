<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Способ распространения: development | ad-hoc | app-store | enterprise -->
	<key>method</key>
	<string>development</string>

	<!-- Подпись: automatic (Xcode сам выберет сертификат из аккаунта) -->
	<key>signingStyle</key>
	<string>automatic</string>

	<key>stripSwiftSymbols</key>
	<true/>

	<key>compileBitcode</key>
	<false/>

	<key>destination</key>
	<string>export</string>

	<!-- Для ad-hoc: перечислите UDID устройств (iOS 15+ можно не указывать вручную) -->
	<!--
	<key>provisioningProfiles</key>
	<dict>
		<key>com.ashtr.shifts</key>
		<string>Shift Tracker AdHoc</string>
	</dict>
	-->
</dict>
</plist>
